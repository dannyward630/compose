#!/usr/bin/env python3
"""Run compose.py from the directory this file really lives in, however it was called: by its path in the repo, through
an install symlink such as ~/.local/bin/compose, or through a chain of symlinks (realpath follows every link)."""
import os, sys
os.execv(sys.executable, [sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)), "compose.py"), *sys.argv[1:]])
