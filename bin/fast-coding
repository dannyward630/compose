#!/usr/bin/env python3
"""fast-coding: a frontier model plans, parallel fast implementers build, a local pipeline verifies. Stdlib only.

Layout inside any repo (all of .fast-coding/ and graft/ are git-ignored; `init` ignores them before anything else, nothing here is committed):
  .fast-coding/<project>/linear.json   {"feature": "<Linear issue>"}: the plan is its description, its tasks are issues under it
  .fast-coding/<project>/verify.json    local verification config
  .fast-coding/<project>/results/       tasks.json (the team lead's Linear sync), one JSON per task run, verify results
  .fast-coding/<project>/worktrees/     one git clone per task
  .fast-coding/<project>/design.f0      the project's Frame0 wireframes; frame0/ is its own Frame0 instance's data
Nothing is pushed. The only network calls are the model APIs.
"""
import argparse, ast, fcntl, hashlib, shlex, json, os, re, shutil, signal, subprocess, sys, tempfile, threading, time, urllib.error, urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

DEFAULT_MODEL = "pi:openrouter-fast/z-ai/glm-5.3-flash@preset/glm-5-3-flash-fast"  # pi harness; the OpenRouter preset pins Together, then CoreWeave
# Takes over when an attempt errors, times out, is rate-limited, or misses. None by default: GLM passes where gpt-oss kept missing,
# so a second model is opt-in (`models.fallback` in the config).
FALLBACK_MODEL = None
JEV_DIR = Path(__file__).resolve().parent.parent / "jev"  # the browser agent verify's e2e cases drive: its own uv project
# Harness-reported cost is wrong when a request is pinned to a specific host: OpenCode prices by OpenRouter's catalog default, not
# the pinned provider's rate. These override the reported cost (dollars per million input, output) for the models we pin.
PRICES = {"openrouter/openai/gpt-oss-120b": (0.35, 0.75), "openrouter-fast/openai/gpt-oss-120b@preset/gpt-oss-120b-cerebras": (0.35, 0.75),
          "openrouter-fast/z-ai/glm-5.3-flash@preset/glm-5-3-flash-fast": (0.15, 0.50)}
CONFIG_PATH = Path(os.environ.get("FAST_CODING_CONFIG", Path.home() / ".fast-coding" / "config.json"))
ENV_FILE = CONFIG_PATH.parent / ".env"  # TEXT_MODEL* (Mercury review, jev's text helper) and TYPESAFE_* (jev, acceptance); the process env wins
OPENROUTER_KEY = None  # the active workspace's key; None leaves each harness on its own auth store
MAX_DIFF_LINES = 350          # per task branch, added plus deleted, against its base; a reviewer reads one layer at a time
DOC_RE = re.compile(r"(^|/)(docs?|documentation)/|\.(md|mdx|rst|txt|adoc)$", re.I)  # implementers never add documents
DEP_DIRS = ("node_modules", "vendor", ".venv")  # git-ignored installs a task clone borrows from the main checkout
# graft otherwise appends /graft/ to the tracked .gitignore and writes .ignore in every clone it builds or refreshes, which
# the scope check rightly reads as an edit outside the task. Children (pi, OpenCode, their graft calls) inherit this.
os.environ.setdefault("GRAFT_NO_GITIGNORE", "1")
os.environ.setdefault("GRAFT_NO_IGNORE", "1")

# ---------- global config and workspaces ----------
# ~/.fast-coding/config.json: top-level settings, and `workspaces` whose active entry (`workspace`) overrides them.
#   {"workspace": "work",
#    "models": {"implementer": "pi:...", "fallback": "pi:..." or null, "fix": "pi:...",
#               "crew": {"orchestrator": "claude:<id>", "<role>": "claude:<id>", "default": "claude:<id>", "small": "claude:<id>"}},
#    "env": {"TYPESAFE_API_KEY": "..."},
#    "workspaces": {"work": {"openrouter_api_key": "sk-or-..."}, "personal": {"openrouter_api_key": "sk-or-...", "models": {...}}}}
# `default` is the top level itself; it always exists and is active when `workspace` is unset.
# A model id names its harness: `pi:<provider/model>` runs pi, `claude:<model-id>` runs Claude Code with that model, bare
# `claude` runs Claude Code with its default model, anything else is an OpenCode model id. Teammate sessions run in pi or Claude Code.

CREW_MODELS = {}  # models.crew from the config: role (or default, small) -> claude:<model-id>
LINEAR_KEY = None  # the active workspace's Linear API key, set by apply_config; never printed or passed in argv
WORKSPACE = "default"
CREW_EFFORT = {}  # the same keys -> Claude Code --effort, for entries written as {"model": ..., "effort": ...}
CREW_FALLBACK = {}  # the same keys -> [(model, effort), ...] to try in order when the entry's own model fails its availability probe
PLANNING_ROLES = ("wayfinder",)  # the product owner and the engineering manager plan through it; the team lead delegates, so it never gets `planner`
LINEAR_ROLES = ("wayfinder", "planner", "designer")  # briefs that read and write Linear: only Claude Code sessions have the Linear MCP tools, pi sessions do not
CREW_DEFAULTS = {"designer": ("claude:claude-opus-5-5", "high")}  # role -> (model, effort) used when models.crew has no entry for it
PROBE_CACHE = Path.home() / ".fast-coding" / "model-probe.json"

def is_claude(model):
    return model == "claude" or str(model).startswith("claude:")

def claude_id(model):
    """The --model value for a Claude model id, or None for bare `claude` (Claude Code's own default)."""
    return (model.split(":", 1)[1] or None) if str(model).startswith("claude:") else None

def read_config():
    return json.loads(CONFIG_PATH.read_text()) if CONFIG_PATH.exists() else {}

def write_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(CONFIG_PATH, json.dumps(cfg, indent=2) + "\n")
    CONFIG_PATH.chmod(0o600)  # it holds API keys

def settings(cfg):
    """The active workspace's settings: the top level with the workspace's entry merged over it, one level deep."""
    name = cfg.get("workspace") or "default"
    if name != "default" and name not in cfg.get("workspaces", {}):
        sys.exit(f"{CONFIG_PATH}: active workspace {name!r} is not under \"workspaces\"")
    ws = cfg.get("workspaces", {}).get(name, {})
    out = {k: v for k, v in cfg.items() if k not in ("workspace", "workspaces")}
    for k, v in ws.items():
        out[k] = {**out[k], **v} if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return name, out

def apply_config():
    """Point models, keys, and env at the active workspace. Its key wins over the shell and the jev .env, and every
    OpenRouter caller (pi, OpenCode, the Mercury review, jev's e2e text helper) bills to it."""
    global DEFAULT_MODEL, FALLBACK_MODEL, OPENROUTER_KEY, CREW_MODELS, CREW_EFFORT, CREW_FALLBACK, LINEAR_KEY, WORKSPACE
    name, st = settings(read_config())
    WORKSPACE, LINEAR_KEY = name, st.get("linear_api_key") or None  # the CLI moves Linear states with it (full path only)
    models = st.get("models", {})
    crew = models.get("crew") or {}  # an entry is "claude:<id>" or {"model": "claude:<id>", "effort": "high"}
    CREW_MODELS = {k: (v.get("model") if isinstance(v, dict) else v) for k, v in crew.items()}
    CREW_EFFORT = {k: v["effort"] for k, v in crew.items() if isinstance(v, dict) and v.get("effort")}
    entry = lambda e: (e.get("model"), e.get("effort")) if isinstance(e, dict) else (e, None)
    CREW_FALLBACK = {k: [entry(f) for f in (v["fallback"] if isinstance(v["fallback"], list) else [v["fallback"]])]
                     for k, v in crew.items() if isinstance(v, dict) and v.get("fallback")}  # one entry or an ordered list
    DEFAULT_MODEL = models.get("implementer", DEFAULT_MODEL)
    FALLBACK_MODEL = models.get("fallback", FALLBACK_MODEL)
    if "fix" in models:
        os.environ["FAST_CODING_FIX_MODEL"] = models["fix"]
    os.environ.update({k: str(v) for k, v in st.get("env", {}).items()})
    if "openrouter_api_key" in st:
        if not st["openrouter_api_key"]:
            sys.exit(f"{CONFIG_PATH}: workspace {name!r} has an empty openrouter_api_key")
        OPENROUTER_KEY = st["openrouter_api_key"]
        os.environ["OPENROUTER_API_KEY"] = os.environ["TEXT_MODEL_API_KEY"] = OPENROUTER_KEY
        os.environ["OPENCODE_CONFIG_CONTENT"] = json.dumps({"provider": {"openrouter": {"options": {"apiKey": OPENROUTER_KEY}}}})
    return name

WORKSPACE_ACTIONS = ("add", "key", "remove")

def read_key(name, kind="OpenRouter"):
    """The key from piped stdin (`pbpaste | fast-coding workspace key personal`) or a hidden prompt; never an argument,
    so it stays out of shell history, the process list, and chat."""
    if not sys.stdin.isatty():
        return sys.stdin.read().strip()
    import getpass
    return getpass.getpass(f"{kind} API key for {name} (empty to set later): ").strip()

def cmd_workspace(a):
    """`workspace` lists, `workspace <name>` switches, `workspace add|key|remove <name>` manages. `default` always exists:
    it is the config's top level, with no overrides."""
    cfg = read_config()
    spaces = cfg.setdefault("workspaces", {})
    action, name = (a.name, a.target) if a.name in WORKSPACE_ACTIONS else (None, a.name)
    if action and not name:
        sys.exit(f"usage: fast-coding workspace {action} <name>")
    if name and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", name):
        sys.exit(f"workspace names are letters, digits, - and _: {name!r}")
    if name and name != "default" and action != "add" and name not in spaces:
        sys.exit(f"no workspace {name!r}; have: {', '.join(['default', *spaces])}. Create it: fast-coding workspace add {name}")
    if action == "add":
        if name == "default" or name in WORKSPACE_ACTIONS or name in spaces:
            sys.exit(f"workspace {name!r} already exists" if name in spaces or name == "default" else f"{name!r} is a reserved word")
        spaces[name] = {"openrouter_api_key": read_key(name)}  # empty fails loudly on use instead of billing another account
        print(f"added {name}" + ("" if spaces[name]["openrouter_api_key"] else f"; no key yet: pbpaste | fast-coding workspace key {name}"))
    elif action == "key":
        linear = getattr(a, "linear", False)
        key = read_key(name, "Linear" if linear else "OpenRouter")
        if not key:
            sys.exit("no key read; copy it, then: pbpaste | fast-coding workspace key " + name + (" --linear" if linear else ""))
        (cfg if name == "default" else spaces[name])["linear_api_key" if linear else "openrouter_api_key"] = key
        print(f"{name}: {'Linear' if linear else 'OpenRouter'} key set")
    elif action == "remove":
        if name == "default":
            sys.exit("default always exists; clear its key in the config's top level instead")
        del spaces[name]
        if cfg.get("workspace") == name:
            cfg["workspace"] = "default"
            print(f"removed the active workspace {name}; now on default")
    elif name:
        cfg["workspace"] = name
    if action or name:
        write_config(cfg)
    current = cfg.get("workspace") or "default"
    for n, entry in [("default", cfg), *spaces.items()]:
        key = entry.get("openrouter_api_key")
        state = "…" + key[-4:] if key else "not set" if "openrouter_api_key" in entry else "harness auth stores" if n == "default" else "inherits default"
        lin = "set" if entry.get("linear_api_key") else "inherits default" if n != "default" and "linear_api_key" in cfg else "not set"
        print(f"{'*' if n == current else ' '} {n:16} openrouter key {state}, linear key {lin}")
    _, st = settings(cfg)
    m = st.get("models", {})
    print(f"implementer {m.get('implementer', DEFAULT_MODEL)}\nfallback    {m.get('fallback', FALLBACK_MODEL)}\nfix         {m.get('fix', '(implementer)')}")
    show = lambda e: (f"{e.get('model')}" + (f" ({e['effort']} effort)" if e.get("effort") else "")) if isinstance(e, dict) else str(e)
    for role, entry in (m.get("crew") or {}).items():
        fb = entry.get("fallback") if isinstance(entry, dict) else None
        fbs = fb if isinstance(fb, list) else [fb] if fb else []  # one fallback or an ordered list of them
        print(f"crew {role:14} {show(entry)}" + "".join(f", else {show(f)}" for f in fbs))

# ---------- output and cost ledger ----------

def now():
    return time.strftime("%H:%M:%S")

def fmt(seconds):
    return f"{seconds:.1f}s" if seconds < 90 else f"{int(seconds // 60)}m{seconds % 60:04.1f}s"

def say(msg):
    print(f"[{now()}] {msg}", flush=True)

class Ledger:
    """Tokens and dollars per provider. cost=None means tokens are known but no price is configured."""
    def __init__(self):
        self.lock, self.rows = threading.Lock(), {}
    def add(self, provider, tokens_in=0, tokens_out=0, cost=None, calls=1):
        with self.lock:
            r = self.rows.setdefault(provider, {"calls": 0, "tokens_in": 0, "tokens_out": 0, "cost": 0.0, "priced": True})
            r["calls"] += calls; r["tokens_in"] += tokens_in; r["tokens_out"] += tokens_out
            if cost is None:
                r["priced"] = False
            else:
                r["cost"] += cost
    def total(self):
        return sum(r["cost"] for r in self.rows.values())
    def line(self):
        parts = [f"{p} ${r['cost']:.4f}" + ("" if r["priced"] else "+?") + f" ({r['calls']} calls, {r['tokens_in']}in/{r['tokens_out']}out)"
                 for p, r in sorted(self.rows.items())]
        return "cost  " + "  ".join(parts) + f"  total ${self.total():.4f}" if parts else "cost  none"
    def snapshot(self):
        return {**{p: dict(r) for p, r in self.rows.items()}, "total": round(self.total(), 6)}

LEDGER = Ledger()

def sh(cmd, cwd, timeout=None, check=True, env=None):
    p = subprocess.run(cmd, cwd=cwd, shell=isinstance(cmd, str), capture_output=True, text=True,
                       timeout=timeout, stdin=subprocess.DEVNULL, env=env)
    if check and p.returncode:
        raise RuntimeError(f"{cmd}\n{p.stdout}\n{p.stderr}")
    return p

def worktrees(repo):
    """Every checkout of this repository (main plus linked worktrees), as paths."""
    out = []
    for line in sh(["git", "worktree", "list", "--porcelain"], repo, check=False).stdout.splitlines():
        if line.startswith("worktree "):
            out.append(Path(line[len("worktree "):]))
    return out or [Path(repo).resolve()]

def project_config(proj):
    f = Path(proj) / "verify.json"
    return json.loads(f.read_text()) if f.exists() else {}

def project_branch(proj):
    """The project's branch: `branch` in its verify.json (`init --branch`), else `fast-coding/<name>`."""
    return project_config(proj).get("branch") or f"fast-coding/{Path(proj).name}"

def commit_convention(proj):
    """A repo's commit convention, declared once as `commit_convention` in verify.json: {"types": [...], "example": "feat: ..."}.
    verify.json is where the CLI already reads per-repo settings, and it needs no parsing of prose in AGENTS.md. None when undeclared."""
    conv = project_config(proj).get("commit_convention")
    return conv if isinstance(conv, dict) and conv.get("types") else None

COMMIT_TYPES = {"feat": ["feat"], "fix": ["fix", "feat"], "test": ["test"], "deps": ["chore", "build"], "docs": ["docs", "chore"]}  # kind -> allowed types, best first
CONFIG_FILE_RE = re.compile(r"(^|/)(package(-lock)?\.json|[^/]*\.lock|pnpm-lock\.yaml|go\.(mod|sum)|requirements[^/]*\.txt|[^/]*\.(ya?ml|toml|ini)|\.[^/]*rc(\.\w+)?|[^/]*\.config\.\w+)$")

def typed(message, kind, conv):
    """`message` with the convention's type prefix for what the commit is (feat, fix, test, deps, docs); plain when no convention
    is declared or it allows none of the kind's types."""
    t = next((t for t in COMMIT_TYPES[kind] if conv and t in conv["types"]), None)
    return f"{t}: {message}" if t else message

def commit_rule(conv):
    """The sentence a brief carries so whoever commits follows the repo's convention; empty when none is declared."""
    if not conv:
        return ""
    return (f"Start every commit message with a type prefix, one of {', '.join(conv['types'])} (for example `{conv.get('example') or conv['types'][0] + ': ...'}`): "
            "tests are test, dependencies and config are chore or build, docs are docs, the rest feat or fix. ")

def layer_prefix(repo, proj):
    """Review layer branches are `<prefix>layer-NN`. The prefix recorded in verify.json (written when layers are first built) wins; a project
    whose `fast/<project>/layer-NN` branches already exist, locally or as remote-tracking refs, keeps them; only a project with no layers
    yet gets `<stored branch>-` (`init --branch`), else `fast/<project>/`."""
    cfg, legacy = project_config(proj), f"fast/{Path(proj).name}/"
    if cfg.get("layer_prefix"):
        return cfg["layer_prefix"]
    if sh(["git", "for-each-ref", "--count=1", "--format=%(refname)", f"refs/heads/{legacy}layer-*", f"refs/remotes/*/{legacy}layer-*"], repo, check=False).stdout.strip():
        return legacy
    return f"{cfg['branch']}-" if cfg.get("branch") else legacy

def all_projects(repo):
    """{project name: (worktree path, project dir)} over every worktree. A project lives in its own worktree
    (`fast-coding-<name>` on the project's branch, `fast-coding/<name>` unless `init --branch` chose one), created by `init`; older projects may sit in the main checkout."""
    found = {}
    for wt in worktrees(repo):
        root = wt / ".fast-coding"
        if not root.exists():
            continue
        on_branch = sh(["git", "branch", "--show-current"], wt, check=False).stdout.strip()
        for p in sorted(root.iterdir()):
            if not (p.is_dir() and (p / "verify.json").exists()):
                continue
            # Once a project branch is merged, its folder shows up in other checkouts too; the project's own worktree
            # (checked out on its branch) wins, so clean and status keep pointing at the right place.
            if p.name not in found or on_branch == project_branch(p):
                found[p.name] = (wt, p)
    return found

def project_dir(a):
    """Resolve --project to its directory, and point a.repo at the worktree that holds it, so every git command runs there."""
    repo = Path(a.repo).resolve()
    projects = all_projects(repo)
    if a.project:
        if a.project not in projects:
            sys.exit(f"no project {a.project!r}; `fast-coding init --project {a.project}` creates one. Known: {sorted(projects)}")
        wt, proj = projects[a.project]
    else:
        if len(projects) != 1:
            sys.exit(f"pass --project; found {sorted(projects)}")
        wt, proj = next(iter(projects.values()))
    a.repo = str(wt)
    return proj

# ---------- tasks ----------

# Linear is the record humans and agents share. The team lead reads the feature and its tasks through its Linear MCP tools
# and pipes them to `fast-coding sync` (or `sync --from-linear` reads them with the workspace key), which keeps them in the git-ignored results/tasks.json.
# A task is any issue under the feature (directly or under a story) whose description ends with this block:
#   ```fast-coding
#   id: 001
#   files: server/graph/validate.go
#   protected: server/graph/validate_test.go
#   test: cd server && go test ./graph/ -run TestValidateAnswers
#   ```
# Everything above the block is the implementer's brief. `after` is Linear's own "blocked by" between the feature's tasks.
TASK_BLOCK = re.compile(r"\n*```fast-coding[ \t]*\n(.*?)\n```[ \t]*\n*", re.S)
SYNC_SHAPE = ('{"feature": {"id", "title", "description"}, "issues": [{"id", "title", "description", "status", "parentId", "blockedBy": ["<issue id>"]}]}'
              ": every issue under the feature, its stories' children included")

def task_from_issue(issue):
    """A task meta (with its brief under "body") from a Linear issue whose description carries the fast-coding block, else None."""
    desc = issue.get("description") or ""
    m = TASK_BLOCK.search(desc)
    if not m:
        return None
    meta = {k.strip(): v.strip() for k, v in (l.split(":", 1) for l in m.group(1).splitlines() if ":" in l)}
    if "id" not in meta or "test" not in meta:
        sys.exit(f"{issue['id']}: its fast-coding block needs id and test")
    for key in ("files", "protected", "nodes"):
        meta[key] = [f.strip() for f in meta.get(key, "").split(",") if f.strip()]
    if "figma" in meta:  # a design task's own file, a key or a url; else the project's stored key
        meta["figma"] = figma_key(meta["figma"]) or sys.exit(f"{issue['id']}: figma is not a Figma file url or key: {meta['figma']}")
    meta.setdefault("kind", "code")
    meta.setdefault("model", DEFAULT_MODEL)
    meta.update({"title": issue.get("title", ""), "linear": issue["id"], "linear_state": issue.get("status", ""),
                 "blocked_by": [b["id"] if isinstance(b, dict) else b for b in issue.get("blockedBy") or []],  # MCP gives {id, title}
                 "body": TASK_BLOCK.sub("\n", desc).strip()})
    return meta

def sync_tasks(proj, data):
    """Store the feature and its tasks, as the team lead read them from Linear, in results/tasks.json. Returns the tasks."""
    link = proj / "linear.json"
    feature = json.loads(link.read_text()).get("feature") if link.exists() else None
    if not feature:
        sys.exit(f'{link}: needs {{"feature": "<issue id, e.g. ENG-123>"}}, the Linear feature this project builds')
    if not isinstance(data, dict) or not isinstance(data.get("feature"), dict) or not isinstance(data.get("issues"), list):
        sys.exit(f"sync reads JSON on stdin shaped {SYNC_SHAPE}")
    if data["feature"].get("id") != feature:
        sys.exit(f"sync got feature {data['feature'].get('id')!r}, but {link} says {feature!r}")
    stories = set(json.loads(link.read_text()).get("stories") or [])
    if stories:  # a project scoped to stories sees those stories and their children, nothing else under the feature
        missing = [i["id"] for i in data["issues"] if i["id"] not in stories and "parentId" not in i]
        if missing:
            sys.exit(f"{link} scopes this project to stories, so sync needs each issue's parentId (get_issue field `parentId`): "
                     f"missing on {', '.join(missing)}")
        data = {**data, "issues": [i for i in data["issues"] if i["id"] in stories or i.get("parentId") in stories]}
    # A canceled issue is no task even with its block still on: a re-plan or an undo canceled it, and it must not run or stack.
    tasks = [t for t in (task_from_issue(i) for i in data["issues"] if (i.get("status") or "").lower() not in CANCELED) if t]
    ids = [t["id"] for t in tasks]
    dupes = sorted({i for i in ids if ids.count(i) > 1})
    if dupes:
        sys.exit(f"{feature}: task ids used twice: {', '.join(dupes)}")
    by_issue = {t["linear"]: t["id"] for t in tasks}
    for t in tasks:  # blockers outside this feature's tasks do not stack
        t["after"] = ",".join(sorted(by_issue[b] for b in t.pop("blocked_by") if b in by_issue))
    tasks.sort(key=lambda t: t["id"])
    (proj / "results").mkdir(exist_ok=True)
    f = data["feature"]
    issues = {i["id"]: {"title": i.get("title", ""), "description": i.get("description") or "", "status": i.get("status") or "",
                        "blockedBy": sorted(b["id"] if isinstance(b, dict) else b for b in i.get("blockedBy") or []),
                        **({"parentId": i["parentId"]} if i.get("parentId") else {})}
              for i in data["issues"]}  # whole, stories too: a change of course snapshots them and undo puts them back
    atomic_write((proj / "results" / "tasks.json"), json.dumps({"synced_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "feature": {"id": f["id"], "title": f.get("title", ""), "description": f.get("description") or ""}, "tasks": tasks,
        "issues": issues}, indent=2))
    if any((proj / "tasks").glob("*.md")):
        say(f"note: {proj / 'tasks'} still has task files; they are ignored, Linear is the record. Delete them.")
    return tasks

LINEAR_TREE_FIELDS = """identifier title description state { name } parent { identifier }
  inverseRelations(first: 250) { nodes { type issue { identifier } } }"""
LINEAR_FEATURE = "query($id: String!) { issue(id: $id) { %s } }" % LINEAR_TREE_FIELDS
LINEAR_CHILDREN = """query($id: String!, $after: String) { issue(id: $id) { children(first: 50, after: $after) {
  pageInfo { hasNextPage endCursor } nodes { %s } } } }""" % LINEAR_TREE_FIELDS

def linear_children(ident):
    """Every child of an issue with the sync fields, all pages."""
    nodes, after = [], None
    while True:
        page = linear_gql(LINEAR_CHILDREN, {"id": ident, "after": after})["issue"]["children"]
        nodes += page["nodes"]
        if not page["pageInfo"]["hasNextPage"]:
            return nodes
        after = page["pageInfo"]["endCursor"]

def linear_sync_payload(proj):
    """The payload `sync` takes on stdin, read from Linear (read-only) for the feature in linear.json: the feature, its
    children, and theirs. A project scoped to stories fetches only those stories' children."""
    link = json.loads((proj / "linear.json").read_text()) if (proj / "linear.json").exists() else {}
    if not link.get("feature"):
        sys.exit(f'{proj / "linear.json"}: needs {{"feature": "<issue id, e.g. ENG-123>"}}, the Linear feature this project builds')
    if not LINEAR_KEY:
        sys.exit(f"sync --from-linear needs a Linear key for workspace {WORKSPACE!r}: pbpaste | fast-coding workspace key {WORKSPACE} --linear; "
                 f"or pipe the JSON on stdin to `fast-coding sync --project {proj.name}` ({SYNC_SHAPE})")
    stories = set(link.get("stories") or [])
    try:
        feature = linear_gql(LINEAR_FEATURE, {"id": link["feature"]})["issue"]
        if not feature:
            sys.exit(f"sync --from-linear: Linear has no issue {link['feature']}")
        issues = []
        for child in linear_children(link["feature"]):
            if stories and child["identifier"] not in stories:
                continue
            issues += [child, *linear_children(child["identifier"])]
    except (RuntimeError, OSError) as e:  # urllib errors name the status, never the key
        sys.exit(f"sync --from-linear: Linear failed ({str(e)[:200]}); the stdin form still works ({SYNC_SHAPE})")
    return {"feature": {"id": feature["identifier"], "title": feature["title"], "description": feature["description"] or ""},
            "issues": [{"id": i["identifier"], "title": i["title"], "description": i["description"] or "", "status": i["state"]["name"],
                        "parentId": i["parent"]["identifier"] if i["parent"] else None,
                        "blockedBy": [r["issue"]["identifier"] for r in i["inverseRelations"]["nodes"] if r["type"] == "blocks"]}
                       for i in issues]}

def atomic_write(path, text):
    """Write a state file so a reader sees the old file or the new one, never a half-written or empty one."""
    path = Path(path)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)

def linear_cache(proj):
    path = proj / "results" / "tasks.json"
    return json.loads(path.read_text()) if path.exists() else {"feature": {}, "tasks": []}

def load_tasks(proj, required=False):
    """The tasks as the team lead last synced them from Linear. Commands that act on tasks require a sync."""
    if required and not (proj / "results" / "tasks.json").exists():
        sys.exit(f"no tasks synced for {proj.name}: read the feature and its tasks from Linear and pipe them to "
                 f"`fast-coding sync --project {proj.name}` (JSON {SYNC_SHAPE})")
    return linear_cache(proj)["tasks"]

def linear_done(meta):
    """Linear says the task is Done: its work is on trunk, whatever this project's own files say."""
    return (meta.get("linear_state") or "").lower() == "done"

def code_tasks(tasks):
    """The tasks that change code: a design task never clones, stacks, or is judged from files."""
    return [t for t in tasks if t.get("kind") != "design"]

def digests(root, files):
    return {f: hashlib.sha256((root / f).read_bytes()).hexdigest() if (root / f).exists() else None for f in files}

def opencode(cwd, model, prompt, session=None, timeout=600):
    """One OpenCode turn. Returns (session, reply_text, tool_calls, usage). Usage comes from step-finish events."""
    # --dir is required: with a git worktree, opencode otherwise resolves the project root to the main checkout and edits it.
    cmd = ["opencode", "run", "--format", "json", "--dir", str(cwd), "--model", model] + (["--session", session] if session else []) + [prompt]
    # stdin must be closed: opencode run reads a piped stdin until EOF and hangs on an open one.
    for attempt in range(4):
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        # Parallel launches race on opencode's shared SQLite file. Back off and retry; nothing has run yet when this happens.
        if p.returncode and "database is locked" in (p.stdout + p.stderr) and attempt < 3:
            time.sleep(0.7 * (attempt + 1) + 0.3 * (hash(str(cwd)) % 5) / 5)
            continue
        break
    sid, text, tools, usage, errors = session, [], 0, {"tokens_in": 0, "tokens_out": 0, "cost": 0.0}, []
    for line in p.stdout.splitlines():
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        sid = sid or ev.get("sessionID")
        part = ev.get("part", {})
        if ev.get("type") == "error":
            err = ev.get("error") or {}
            data = err.get("data") or {}
            payment_check("cerebras/groq via OpenRouter (OpenCode)", data.get("message") or json.dumps(err), data.get("statusCode"))
            errors.append(str(data.get("message") or err.get("name") or err))
        elif ev.get("type") == "text":
            text.append(part.get("text", ""))
        elif ev.get("type") == "tool_use":
            tools += 1
        elif ev.get("type") == "step_finish":
            t = part.get("tokens", {})
            usage["tokens_in"] += t.get("input", 0) + t.get("cache", {}).get("read", 0) + t.get("cache", {}).get("write", 0)
            usage["tokens_out"] += t.get("output", 0) + t.get("reasoning", 0)
            usage["cost"] += part.get("cost") or 0.0
    if p.returncode and not sid:
        raise RuntimeError(f"opencode failed: {p.stderr[-2000:]}")
    if errors and not text and not tools:
        # The model never ran: the provider refused (bad key, payment required, model missing). Retrying is pointless.
        raise RuntimeError(f"provider refused the request: {'; '.join(errors)[-400:]}")
    if model in PRICES:
        usage["cost"] = (usage["tokens_in"] * PRICES[model][0] + usage["tokens_out"] * PRICES[model][1]) / 1e6
    LEDGER.add(model.split("/")[0], usage["tokens_in"], usage["tokens_out"], usage["cost"])
    reply = "\n".join(text)
    # A provider 429 makes opencode compact the session into a "Work State / Next Move" summary and stop.
    # That session is unusable afterwards; the caller must wait for the window to reset and start a fresh one.
    if RATE_LIMIT_MARK in reply or "Tokens per minute" in (p.stderr or ""):
        raise RateLimited(usage)
    return sid, reply, tools, usage

RATE_LIMIT_MARK = "exceeded the provider's size limit"

def pi_error(m):
    """The provider's own error text from a pi assistant message that ended with stopReason=error, else None. A missing preset
    is named with the active workspace, since the preset lives in that workspace's OpenRouter account."""
    if m.get("stopReason") != "error":
        return None
    err = str(m.get("errorMessage") or "provider error")
    try:
        meta = json.loads(err.split(": ", 1)[1])["metadata"]
    except (IndexError, KeyError, TypeError, ValueError):
        meta = {}
    if meta.get("presetErrorCode") == "preset_not_found":
        err += f" (preset '{meta.get('presetSlug')}' not found in workspace '{WORKSPACE}')"
    return err

def pi_turn(cwd, model, prompt, session=None, timeout=None):
    timeout = timeout or TURN_TIMEOUT
    """One turn through pi (github.com/earendil-works/pi), the lean harness: ~1K tokens of fixed context per turn against
    OpenCode's ~12K. Same contract as opencode(): (session, reply_text, tool_calls, usage). The session lives outside the
    task clone so `git add -A` never commits it. Model ids are pi's `provider/model`, e.g. openrouter-fast/z-ai/glm-5.3-flash@preset/glm-5-3-flash-fast."""
    sdir = Path(cwd).parent / (Path(cwd).name + ".pi-sessions")
    sdir.mkdir(exist_ok=True)
    import uuid
    sid = session or str(uuid.uuid4())  # --session-id must be a UUID
    env = dict(os.environ)
    if "OPENROUTER_API_KEY" not in env and load_env(ENV_FILE).get("TEXT_MODEL_API_KEY"):  # pi's custom providers read the key from env
        env["OPENROUTER_API_KEY"] = load_env(ENV_FILE)["TEXT_MODEL_API_KEY"].strip('"')
    cmd = ["pi", "-p", "--mode", "json", "--session-id", sid, "--session-dir", str(sdir), "--no-extensions", "--no-skills",
           "--no-prompt-templates", "--thinking", "low", "--model", model, *(["--api-key", OPENROUTER_KEY] if OPENROUTER_KEY else []), prompt]
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, env=env)
    text, tools, usage, errors, last = [], 0, {"tokens_in": 0, "tokens_out": 0, "cost": 0.0}, [], None
    for line in p.stdout.splitlines():
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        t = ev.get("type")
        if t == "tool_execution_start":
            tools += 1
        elif t == "message_update" and ev.get("usage"):
            last = ev["usage"]  # cumulative within the current assistant message
        elif t == "message_end" and (ev.get("message") or {}).get("role") == "assistant":
            for part in ev["message"].get("content") or []:
                if part.get("type") == "text":
                    text.append(part.get("text", ""))
            if err := pi_error(ev["message"]):
                payment_check("openrouter (pi)", err)
                errors.append(err[:400])
            if last:
                usage["tokens_in"] += last.get("input", 0) + last.get("cacheRead", 0) + last.get("cacheWrite", 0)
                usage["tokens_out"] += last.get("output", 0) + last.get("reasoning", 0)
                usage["cost"] += (last.get("cost") or {}).get("total") or 0.0
                last = None
        elif t == "error" or ev.get("error"):
            payment_check("openrouter (pi)", json.dumps(ev.get("error") or ev))
            errors.append(str(ev.get("error") or ev)[:300])
    if p.returncode and not text and not tools:
        real = [l for l in (p.stderr or "").splitlines() if l.strip() and not l.startswith("Warning:")]
        payment_check("openrouter (pi)", " ".join(real))
        raise RuntimeError(f"pi failed: {' '.join(real)[-400:] or p.stdout.strip()[-400:]}")
    if not text and not tools and not usage["tokens_in"]:
        real = [l for l in (p.stderr or "").splitlines() if l.strip() and not l.startswith("Warning:")]  # pi's session warnings are not the provider's answer
        raise RuntimeError(f"provider refused the request: {'; '.join(errors) or ' '.join(real)[-400:] or 'empty reply with no usage'}")
    if model in PRICES:
        usage["cost"] = (usage["tokens_in"] * PRICES[model][0] + usage["tokens_out"] * PRICES[model][1]) / 1e6
    LEDGER.add("openrouter" if "openrouter" in model else model.split("/")[0], usage["tokens_in"], usage["tokens_out"], usage["cost"])
    if "429" in (p.stderr or "") or any("rate" in e.lower() and "limit" in e.lower() for e in errors):
        raise RateLimited(usage)
    return sid, "\n".join(text), tools, usage

def fallback_for(model):
    """The model to switch to after a miss, or None when there is nothing to fall back to (the fallback itself, Claude, or none set)."""
    return FALLBACK_MODEL if FALLBACK_MODEL and model != FALLBACK_MODEL and not is_claude(model) else None

def implementer(cwd, model, prompt, session=None, task=None, timeout=None):
    """Route a turn to the harness named by the model id: `pi:<provider/model>` runs pi (as a named herdr agent when the run
    is inside herdr and `task` names the project's space), anything else runs OpenCode."""
    fake = os.environ.get("FAST_CODING_FAKE_402")  # test hook: behave as if the provider refused for billing (optionally only for prompts matching)
    if fake and os.environ.get("FAST_CODING_FAKE_402_MATCH", "") in prompt:
        raise PaymentRequired(fake, "Payment required to access this resource (simulated)")
    if is_claude(model):
        return claude_once(cwd, prompt, model=claude_id(model))
    if model.startswith("pi:"):
        if herdr_env() and task and task.get("space"):
            return herdr_pi(cwd, model[3:], prompt, session, task, timeout)
        return pi_turn(cwd, model[3:], prompt, session, timeout)
    return opencode(cwd, model, prompt, session)

class PaymentRequired(Exception):
    """A provider refused for billing reasons. Nothing retries this: the run halts, the state is saved, the user tops up, `resume` continues."""
    def __init__(self, provider, message):
        super().__init__(f"{provider}: {message}")
        self.provider, self.message = provider, message

PAY_RE = re.compile(r"payment required|insufficient[ _](credits?|quota|funds|balance)|credit balance|out of credits?|exceeded your current quota|"
                    r"billing|\b402\b|account (is )?(suspended|disabled|past due)|top up", re.I)
TOP_UP = {"openrouter": "https://openrouter.ai/settings/credits", "cerebras": "https://cloud.cerebras.ai (Billing)",
          "typesafe": "https://typesafe.ai dashboard (Billing)", "groq": "https://console.groq.com (Billing)"}

def payment_check(provider, text, status=None):
    """Raise PaymentRequired when an HTTP status or an error message says the account cannot pay."""
    if status == 402 or (text and PAY_RE.search(str(text))):
        raise PaymentRequired(provider, str(text)[:300].strip() or f"HTTP {status}")

def http_json(req, provider, timeout=90):
    """urlopen that turns a 402 (or a 200 carrying a billing error) into PaymentRequired instead of a stack trace."""
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            out = json.load(r)
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")[:500]
        payment_check(provider, body, e.code)
        raise RuntimeError(f"{provider}: HTTP {e.code} {e.reason}: {body.strip()}") from e
    err = out.get("error") if isinstance(out, dict) else None
    if err:
        payment_check(provider, json.dumps(err), (err.get("code") if isinstance(err, dict) else None))
    return out

# ---------- Linear: the CLI keeps the state table true, so the team lead spends no model turn on it ----------
# The key is the active workspace's `linear_api_key`; it goes in a header,
# never argv or a results file. Every call is best effort: a Linear outage prints one line and the run goes on.
LINEAR_URL = "https://api.linear.app/graphql"
LINEAR_ISSUE = """query($id: String!) { issue(id: $id) { id identifier state { name type }
  team { states { nodes { id name type } } } parent { identifier } children { nodes { identifier state { name type } } } } }"""
_linear_warned = []

def linear_gql(query, variables):
    req = urllib.request.Request(LINEAR_URL, data=json.dumps({"query": query, "variables": variables}).encode(),
                                 headers={"Content-Type": "application/json", "Authorization": LINEAR_KEY})
    with urllib.request.urlopen(req, timeout=20) as r:
        out = json.load(r)
    if out.get("errors"):
        raise RuntimeError("; ".join(e.get("message", "?") for e in out["errors"])[:300])
    return out["data"]

def linear_issue(ident):
    issue = linear_gql(LINEAR_ISSUE, {"id": ident})["issue"]
    if not issue:
        raise RuntimeError(f"no issue {ident}")
    return issue

def linear_move(issue, state):
    """Move an issue to the team state named `state` (case-insensitive). No-op when it is already there."""
    if (issue["state"]["name"] or "").lower() == state.lower():
        return False
    match = [n for n in issue["team"]["states"]["nodes"] if n["name"].lower() == state.lower()]
    if not match:
        raise RuntimeError(f"{issue['identifier']}: the team has no {state!r} state")
    linear_gql("mutation($id: String!, $s: String!) { issueUpdate(id: $id, input: {stateId: $s}) { success } }",
               {"id": issue["id"], "s": match[0]["id"]})
    say(f"linear {issue['identifier']} -> {state}")
    return True

def linear_comment(issue, body):
    linear_gql("mutation($id: String!, $b: String!) { commentCreate(input: {issueId: $id, body: $b}) { success } }",
               {"id": issue["id"], "b": body})

def linear_ready():
    """True when the workspace has a Linear key; otherwise say once how to set it, and the caller skips Linear."""
    if LINEAR_KEY:
        return True
    if not _linear_warned:
        _linear_warned.append(1)
        say(f"linear skipped: workspace {WORKSPACE!r} has no Linear key; set it: pbpaste | fast-coding workspace key {WORKSPACE} --linear")
    return False

def linear_note(meta, body):
    """A routine comment on a task's issue (held, released). A failure is said and never stops the command."""
    if not meta or not meta.get("linear") or not linear_ready():
        return
    try:
        linear_comment(linear_issue(meta["linear"]), body)
    except Exception as e:  # noqa: BLE001
        say(f"linear {meta['linear']}: comment failed ({str(e)[:200]})")

LINEAR_BLOCKERS = "query($id: String!) { issue(id: $id) { inverseRelations { nodes { id type issue { id identifier } } } } }"

def linear_blocked_by(issue, want):
    """Make exactly the issues in `want` (identifiers) block `issue`."""
    rels = [r for r in linear_gql(LINEAR_BLOCKERS, {"id": issue["id"]})["issue"]["inverseRelations"]["nodes"] if r["type"] == "blocks"]
    have = {r["issue"]["identifier"]: r["id"] for r in rels}
    for ident, rid in have.items():
        if ident not in want:
            linear_gql("mutation($id: String!) { issueRelationDelete(id: $id) { success } }", {"id": rid})
    for ident in want:
        if ident not in have:
            linear_gql("mutation($a: String!, $b: String!) { issueRelationCreate(input: {issueId: $a, relatedIssueId: $b, type: blocks}) { success } }",
                       {"a": linear_issue(ident)["id"], "b": issue["id"]})

def linear_restore(ident, fields):
    """Put an issue's title, description, state, and blockers back as `fields` names them."""
    issue = linear_issue(ident)
    text = {k: fields[k] for k in ("title", "description") if k in fields}
    if text:
        linear_gql("mutation($id: String!, $in: IssueUpdateInput!) { issueUpdate(id: $id, input: $in) { success } }", {"id": issue["id"], "in": text})
    if "status" in fields:
        linear_move(issue, fields["status"])
    if "blockedBy" in fields:
        linear_blocked_by(issue, fields["blockedBy"])

def rollup_state(children):
    """The state table for a story or epic: Done when every child is Done, In Review when every child is In Review or
    Done, In Progress once any child started, else None (leave it)."""
    names = [(c["state"]["name"] or "").lower() for c in children]
    if names and all(n == "done" for n in names):
        return "Done"
    if names and all(n in ("in review", "done") for n in names):
        return "In Review"
    if any(c["state"]["type"] in ("started", "completed") for c in children):
        return "In Progress"
    return None

def linear_roll_up(proj, ident, verified=False):
    """Roll `ident` and its parents up the table. The feature reaches In Review only when verify passed, and the CLI
    never marks the feature Done (that needs the project branch merged)."""
    feature = json.loads((proj / "linear.json").read_text()).get("feature")
    while ident:
        issue = linear_issue(ident)
        target = rollup_state(issue["children"]["nodes"])
        if issue["identifier"] == feature:
            if target in ("In Review", "Done"):
                target = "In Review" if verified else "In Progress"
            if target:
                linear_move(issue, target)
            return
        if target:
            linear_move(issue, target)
        ident = (issue.get("parent") or {}).get("identifier")

def linear_event(proj, meta, event, result=None):
    """One task event through the state table: `dispatched` moves the task In Progress, `passed` In Review with a comment,
    `failed` keeps it In Progress with the failure as a comment; then its story and the feature roll up."""
    if not meta.get("linear"):
        return
    if not linear_ready():
        return
    try:
        issue = linear_issue(meta["linear"])
        if event == "dispatched":
            linear_move(issue, "In Progress")
        elif event == "passed":
            linear_move(issue, "In Review")
            linear_comment(issue, f"Passed: branch `{result['branch']}`, {result['attempts']} attempt(s), ${result['cost']:.4f}, model `{result['model']}`.")
        else:
            linear_move(issue, "In Progress")
            last = (result.get("log") or [{}])[-1]
            tail = (last.get("test_output") or "").strip().splitlines()
            why = last.get("contradiction") or last.get("error") or (tail[-1] if tail else "no detail")
            linear_comment(issue, f"{result['status']} after {result['attempts']} attempt(s) (${result['cost']:.4f}, model `{result['model']}`): {why[:400]}")
        parent = (issue.get("parent") or {}).get("identifier")
        if parent:
            linear_roll_up(proj, parent)
    except Exception as e:  # noqa: BLE001  Linear never stops a run
        say(f"linear {meta.get('linear')}: update failed ({str(e)[:200]}); the run goes on")

def linear_verified(proj):
    """verify PASS: the feature moves to In Review once every story is In Review or Done."""
    link = proj / "linear.json"
    if not link.exists() or not LINEAR_KEY:
        return
    feature = json.loads(link.read_text()).get("feature")
    try:
        linear_roll_up(proj, feature, verified=True)
    except Exception as e:  # noqa: BLE001
        say(f"linear {feature}: update failed ({str(e)[:200]})")

class RateLimited(Exception):
    def __init__(self, usage):
        super().__init__("provider rate limit hit; session compacted")
        self.usage = usage

def headless_env():
    """The environment for a Claude Code process the CLI runs headless: no FAST_CODING_* at all, above all not the herdr
    tab's role, project, and worktree, so the plugin's hooks treat it as no one's session (a team lead's Stop hook would
    park a watch in it, and its guard would block an implementer's edits)."""
    return {k: v for k, v in os.environ.items() if not k.startswith("FAST_CODING_")}

NO_ATTRIBUTION = json.dumps({"attribution": {"commit": "", "pr": ""}})  # `--settings` outranks the user settings: no Co-Authored-By trailer or "Generated with" line on any commit a Claude session makes

def claude_once(cwd, prompt, timeout=900, model=None):
    """One-shot baseline through Claude Code on the subscription. Marginal cost $0; the CLI's own cost figure is recorded for reference."""
    # --model is explicit because ~/.claude/settings.json may carry a launcher-injected default that headless runs cannot use.
    cmd = ["claude", "-p", prompt, "--output-format", "json", "--model", model or os.environ.get("FAST_CODING_CLAUDE_MODEL", "claude-sonnet-5-5"),
           "--settings", NO_ATTRIBUTION, "--permission-mode", "acceptEdits", "--allowedTools", "Read,Edit,Write,Bash,Grep,Glob"]
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, env=headless_env())
    try:
        out = json.loads(p.stdout)
    except json.JSONDecodeError:
        out = {}
    if out.get("is_error"):
        raise RuntimeError(f"claude -p error: {str(out.get('result', ''))[:300]}")
    usage = out.get("usage", {})
    tokens_in = usage.get("input_tokens", 0) + usage.get("cache_read_input_tokens", 0) + usage.get("cache_creation_input_tokens", 0)
    LEDGER.add("claude-subscription", tokens_in, usage.get("output_tokens", 0), 0.0)
    return None, str(out.get("result", ""))[-1500:], out.get("num_turns", 0), {"tokens_in": tokens_in, "tokens_out": usage.get("output_tokens", 0),
                                                                                "cost": 0.0, "reference_cost": out.get("total_cost_usd")}

# ---------- herdr ----------
# Inside herdr (HERDR_ENV=1) the fleet is visible: one space per project, a `status` tab, one tab per task holding a named
# interactive pi agent the team lead can steer with `herdr agent prompt`, and a verify tab of stage panes. Every call
# here is best-effort: outside herdr, or when herdr refuses, the run continues exactly as the headless path would.

HERDR_SPACES = {}  # project name -> workspace id, filled by herdr_space
PI_HERDR_EXT = Path.home() / ".pi" / "agent" / "extensions" / "herdr-agent-state.ts"

def herdr_env():
    return os.environ.get("HERDR_ENV") == "1" and bool(os.environ.get("HERDR_SOCKET_PATH"))

def herdr(*args, check=False, timeout=120):
    """One herdr CLI call. Returns the JSON `result`, or None when not inside herdr or the call failed (raises if check)."""
    if not herdr_env():
        return None
    try:
        p = subprocess.run(["herdr", *map(str, args)], capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        if check:
            raise RuntimeError(f"herdr {' '.join(map(str, args[:2]))}: {e}")
        return None
    try:
        out = json.loads((p.stdout or p.stderr or "{}").strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        out = {}
    if p.returncode or "error" in out:
        if check:
            raise RuntimeError(f"herdr {' '.join(map(str, args[:2]))}: {(out.get('error') or {}).get('code') or p.stderr.strip()[-200:]}")
        return None
    return out.get("result", out)

def herdr_error(*args, timeout=120):
    """Like herdr() but returns the error code string on failure ("timeout", "agent_blocked", ...) instead of None."""
    p = subprocess.run(["herdr", *map(str, args)], capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    try:
        out = json.loads((p.stdout or p.stderr or "{}").strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        out = {}
    if p.returncode or "error" in out:
        return None, ((out.get("error") or {}).get("code") or p.stderr.strip()[-200:] or "error")
    return out.get("result", out), None

def herdr_await_start(agent, tries=3):
    """Return once `agent` has started on its brief, the first prompt it gets. This only confirms the submission landed (status
    working, blocked, or done), presses Enter when the box kept the text without submitting, and fails loudly with the agent name
    when it still did not start."""
    def started():  # `done` counts too: a short first turn can finish before the check
        return ((herdr("agent", "get", agent) or {}).get("agent") or {}).get("agent_status") in ("working", "blocked", "done")
    for attempt in range(tries + 1):
        if attempt:
            herdr("agent", "send-keys", agent, "enter")
        for _ in range(10):
            if started():
                return
            time.sleep(2)
    raise RuntimeError(f"{agent} did not start on its brief; the brief may sit unsent in its tab: press Enter there")

def herdr_start_crew(*args, tries=8):
    """`herdr agent start` for a teammate, retried while its pane is still coming up: starts running in parallel (designcrews,
    testcrews) race each other and the new pane answers agent_pane_busy until its shell is there, or agent_name_not_found while herdr
    has not yet registered the name the start waits for (the session may be up under its pane's default name: it is renamed)."""
    for i in range(tries):
        try:
            return herdr("agent", "start", *args, check=True, timeout=90)
        except RuntimeError as e:
            if ("timeout" in str(e) or "agent_name_not_found" in str(e)) and "--pane" in args:  # the session can come up after the call gave up: name it rather than lose it
                pane = args[args.index("--pane") + 1]
                for _ in range(10):  # it may still be registering with herdr when the call gives up
                    if any(ag.get("pane_id") == pane for ag in live_agents()):
                        print(f"herdr agent start timed out but {args[0]} came up; continuing")
                        return herdr("agent", "rename", pane, args[0], check=True)
                    time.sleep(2)
                if pane_launching(args[0], pane):  # one last look by name and by pane: an agent that can still come up is never declared dead
                    print(f"herdr agent start timed out but {args[0]} is still starting in its pane; continuing")
                    return None
            if not any(c in str(e) for c in ("agent_pane_busy", "agent_name_not_found")) or i == tries - 1:
                raise
            time.sleep(0.5 * (i + 1))

def pane_processes(pane):
    """The processes running in `pane` in front of its shell: empty when the pane holds nothing but an idle shell."""
    info = (herdr("pane", "process-info", "--pane", pane) or {}).get("process_info") or {}
    return [p for p in info.get("foreground_processes", []) if p.get("pid") != info.get("shell_pid")] \
        if info.get("foreground_process_group_id") != info.get("shell_pid") else []

def pane_launching(agent, pane):
    """True when `agent` is registered by name, listed on `pane`, or the pane runs a process that is still becoming it."""
    return bool(herdr("agent", "get", agent)) or any(ag.get("pane_id") == pane for ag in live_agents()) or bool(pane_processes(pane))

def pane_kill(pane):
    """Stop whatever runs in `pane` in front of its shell, so closing the tab leaves nothing unregistered behind."""
    for p in pane_processes(pane):
        try:
            os.kill(p["pid"], signal.SIGTERM)
        except (OSError, KeyError):
            pass

def agent_name(slug, tid):
    """herdr agent names: [a-z][a-z0-9_-]{0,31}, unique among live agents. `<slug>-<id>`, slug trimmed to fit."""
    s = re.sub(r"[^a-z0-9_-]+", "-", slug.lower()).strip("-")
    if not re.match(r"[a-z]", s):
        s = "fc-" + s
    return f"{s[:32 - len(tid) - 1]}-{tid}"

def parse_pi_session(path, seen):
    """Read the pi session JSONL from line `seen` on: assistant text, tool calls, usage, and provider errors of the new turns.
    Same accounting as pi_turn, so the ledger and cost line do not depend on which path ran the task."""
    text, tools, usage, errors = [], 0, {"tokens_in": 0, "tokens_out": 0, "cost": 0.0}, []
    lines = Path(path).read_text().splitlines() if Path(path).exists() else []
    for ln in lines[seen:]:
        try:
            ev = json.loads(ln)
        except json.JSONDecodeError:
            continue
        m = ev.get("message") or {}
        if ev.get("type") != "message" or m.get("role") != "assistant":
            continue
        for part in m.get("content") or []:
            if part.get("type") == "text":
                text.append(part.get("text", ""))
            elif part.get("type") == "toolCall":
                tools += 1
        u = m.get("usage") or {}
        usage["tokens_in"] += u.get("input", 0) + u.get("cacheRead", 0) + u.get("cacheWrite", 0)
        usage["tokens_out"] += u.get("output", 0) + u.get("reasoning", 0)
        usage["cost"] += (u.get("cost") or {}).get("total") or 0.0
        if err := pi_error(m):
            payment_check("openrouter (pi)", err)
            errors.append(err[:400])
    return len(lines), "\n".join(text), tools, usage, errors

def herdr_main_repo(wt):
    common = sh(["git", "rev-parse", "--git-common-dir"], wt, check=False).stdout.strip()
    return str(Path(wt, common).resolve().parent) if common else str(wt)

def herdr_find_space(wt):
    """The workspace id whose checkout is this path (`worktree.checkout_path` in `workspace list`)."""
    wt = str(Path(wt).resolve())
    for w in (herdr("workspace", "list") or {}).get("workspaces", []):
        cp = (w.get("worktree") or {}).get("checkout_path")
        if cp and str(Path(cp).resolve()) == wt:
            return w["workspace_id"]
    return None

def project_worktree(proj):
    """The project's own checkout: proj is `<worktree>/.fast-coding/<name>`."""
    return Path(proj).resolve().parents[1]

def live_agents():
    return (herdr("agent", "list") or {}).get("agents", [])

def herdr_space(proj):
    """Open the project's worktree as its own herdr space labelled `<name>`, grouped under the repo's space. Idempotent.
    Keyed on the project's worktree, never on where a command happens to run (verify runs in the CLI's stack worktree)."""
    if not herdr_env():
        return None
    slug, wt = Path(proj).name, project_worktree(proj)
    if slug in HERDR_SPACES:
        return HERDR_SPACES[slug]
    space = herdr_find_space(wt)
    if not space:
        r = herdr("worktree", "open", "--cwd", herdr_main_repo(wt), "--path", str(wt), "--label", slug, "--no-focus") or {}
        space = (r.get("workspace") or {}).get("workspace_id") or r.get("workspace_id")
    if not space:
        r = herdr("workspace", "create", "--cwd", str(wt), "--label", slug, "--no-focus") or {}
        space = (r.get("workspace") or {}).get("workspace_id")
    if space:
        HERDR_SPACES[slug] = space
        herdr("workspace", "rename", space, slug)
        for label, t in herdr_tabs(space).items():
            if label and label.isdigit():  # the tab herdr opened with the space: a shell in the project worktree
                herdr("tab", "rename", t["tab_id"], "shell")
        herdr_status_tab(space, wt, slug)
    return space

# ---------- `crew`: teammates, the Claude sessions in the project's space, reporting upward ----------
# The product owner talks to the engineering manager (the session they started), which stays where it was launched. Each project gets a
# team lead in its own space (`crew start --role orchestrator`), and the team lead starts teammates of its own (a wayfinder
# question, a researcher). Every teammate session reports with `fast-coding report`; `watch` turns new reports into wake events.
CREW_STATES = ("working", "needs-user", "blocked", "done", "tool-bug", "contradiction", "fallback")
CLI_REPO = Path(__file__).resolve().parent.parent  # the fast-coding repo itself: where a toolsmith fixes the tool
TOOL_BUGS = CONFIG_PATH.parent / "tool-bugs.jsonl"  # every project's tool-bug reports, for the engineering manager

def crew_dir(proj):
    d = proj / "results" / "crew"
    d.mkdir(parents=True, exist_ok=True)
    return d

def crew_reports(proj, name):
    f = crew_dir(proj) / f"{name}.status"
    return [json.loads(l) for l in f.read_text().splitlines() if l.strip()] if f.exists() else []

def scratch_dir(proj, name=None):
    return proj / "scratch" / name if name else proj / "scratch"

def listeners_under(root):
    """Pids listening on a TCP port whose working directory is inside `root`: the servers and dev watchers a teammate or run
    left behind. Listening narrows it to servers, so the herdr shells and agent sessions that also sit in the worktree stay."""
    pids = set(sh("lsof -nP -iTCP -sTCP:LISTEN -t", ".", check=False).stdout.split())
    root, out = str(Path(root).resolve()), []
    for pid in pids:
        cwd = next((l[1:] for l in sh(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"], ".", check=False).stdout.splitlines()
                    if l.startswith("n")), "")
        if cwd == root or cwd.startswith(root + "/"):
            out.append(pid)
    return out

def stop_listeners_under(root):
    pids = listeners_under(root)
    if pids:
        sh(["kill", *pids], ".", check=False)
    return pids

def crew_preamble(proj, name, title):
    up = "the engineering manager, who relays to the product owner" if name == agent_name(proj.name, "orchestrator") else f"{agent_name(proj.name, 'orchestrator')}, your team lead"
    report = f"fast-coding report --repo {project_worktree(proj)} --project {proj.name} --as {name}"
    return (f"You are {name}, a teammate on fast-coding project {proj.name} ({title}), in your own herdr tab. You report to {up}.\n"
            f"Report every change that matters, one line each, and never stop without one:\n"
            f"- `{report} needs-user \"<the question, with your recommendation>\"` when you wait for the product owner (they may answer here in "
            f"your pane, or through whoever you report to)\n"
            f"- `{report} blocked \"<what stops you>\"`, `{report} working \"<milestone>\"`, and `{report} done \"<outcome, with Linear ids>\"` last\n"
            f"`done` means nothing is left for you: your tab closes when that turn ends. Work waiting on review is `working`, not `done`.\n"
            f"When fast-coding itself fails (the CLI crashes, behaves wrongly, or lacks something you need), as opposed to the project's code: "
            f"work around it to keep going, never edit the fast-coding repo, and report `{report} tool-bug \"<symptom, evidence, workaround used>\"`.\n"
            f"When something you find contradicts what Linear says (a decision, a brief, a criterion), report it at once: "
            f"`{report} contradiction \"<what you found>; Linear says: <quoted line> (<issue>); evidence: <file:line or command output>\"`, "
            f"then keep working on what it does not touch, and never re-scope your brief.\n"
            f"Linear is the record: write what you learn and decide there, never to files.\n"
            f"Commit messages describe the change itself in plain words; never mention fast-coding, waves, task ids, teammates, or Linear. "
            f"{commit_rule(commit_convention(proj))}"
            f"Write the simplest code and the fewest tests that cover the requirements: one test file per unit, extended in place.\n"
            f"Fact-check before you say it: every claim about the code, a tool, or a result comes from evidence you gathered (graft "
            f"output with file:line, a command and its output, a test run). Keep facts apart from hypotheses, write 'not verified' "
            f"or 'unknown' instead of a guess, and report failures and partial results plainly with the evidence.\n"
            f"Never write the feature's implementation, not even a throwaway reference to prove tests pass: the implementers write it, "
            f"and a test failing on the stubs plus the team lead's read of it is the proof.\n"
            f"Scratch copies and temporary files go under {scratch_dir(proj, name)}, never /tmp or your home. Stop every server, "
            f"watcher, and browser you start before you report done; teardown kills what is left listening there.\n\n")

_PROBED = {}

def pi_id(model):
    """The --model value for a `pi:<provider/model>` id."""
    return model.split(":", 1)[1]

def pi_key_args(model):
    """pi's --api-key for the workspace's OpenRouter key, only for models routed through OpenRouter (others keep pi's own auth)."""
    return ["--api-key", OPENROUTER_KEY] if OPENROUTER_KEY and "openrouter" in pi_id(model) else []

def probe_command(model):
    if model.startswith("pi:"):
        return ["pi", "-p", "--mode", "json", "--no-session", "--no-extensions", "--no-skills", "--no-prompt-templates", "--no-context-files",
                "--thinking", "off", "--model", pi_id(model), *pi_key_args(model), "Reply with exactly: ok"]
    return ["claude", "-p", "--model", claude_id(model), "--output-format", "json", "Reply with exactly: ok"]

def probe_result(model, p):
    """(ok, why) from a finished probe process: Claude Code reports `is_error` in its JSON; pi streams events, so a clean exit
    plus an assistant text reply is ok and anything else is the error it printed."""
    if model.startswith("pi:"):
        events = []
        for line in p.stdout.splitlines():
            try:
                events.append(json.loads(line))
            except json.JSONDecodeError:
                pass
        done = [e["message"] for e in events if e.get("type") == "message_end" and (e.get("message") or {}).get("role") == "assistant"]
        failed = next(filter(None, map(pi_error, done)), None)  # a refused model still ends its turn
        replied = any(c.get("type") == "text" and c.get("text") for m in done for c in m.get("content") or [])
        if p.returncode == 0 and replied and not failed:
            return True, "answered"
        return False, (failed or p.stderr or p.stdout or f"exit {p.returncode}").strip()[:160]
    out = json.loads(p.stdout.strip()) if p.stdout.strip().startswith("{") else {}
    ok = p.returncode == 0 and out.get("is_error") is False
    return ok, "answered" if ok else (out.get("result") or p.stderr or p.stdout or f"exit {p.returncode}").strip()[:160]

def model_available(model):
    """Whether the harness named by `model` (a claude:<id> or pi:<provider/model>) can run it on this account: one tiny
    non-interactive turn, cached for the day in ~/.fast-coding/model-probe.json. Returns (ok, why)."""
    mid, today = model.split(":", 1)[1] if ":" in model else "", time.strftime("%Y-%m-%d")
    if not mid:
        return True, "Claude Code's default model"
    if mid in _PROBED:
        return _PROBED[mid]
    try:
        cache = json.loads(PROBE_CACHE.read_text()) if PROBE_CACHE.exists() else {}
    except (OSError, json.JSONDecodeError):
        cache = {}
    hit = cache.get(mid)
    if hit and hit.get("date") == today:
        _PROBED[mid] = (hit["ok"], hit["why"])
        return _PROBED[mid]
    ok, why, transient = probe_once(model, 60)
    if transient:  # a slow start-up or a busy API says nothing about the account: retry once, longer, and never cache it
        ok, why, transient = probe_once(model, 180)
    _PROBED[mid] = (ok, why)
    if not transient:
        cache[mid] = {"date": today, "ok": ok, "why": why}
        PROBE_CACHE.parent.mkdir(parents=True, exist_ok=True)
        atomic_write(PROBE_CACHE, json.dumps(cache, indent=2))
    return ok, why

TRANSIENT = re.compile(r"overloaded|rate.?limit|too many requests|\b(5\d\d|429)\b|timed? ?out|temporar|try again|unavailable|connection|ECONN", re.I)

def probe_once(model, timeout):
    """(ok, why, transient) from one probe turn. Only a clear answer (ok, or a refusal such as an unknown model) is definite."""
    try:
        p = subprocess.run(probe_command(model), capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, env=headless_env())
        ok, why = probe_result(model, p)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as e:
        return False, f"{type(e).__name__}: {e}"[:160], True
    return ok, why, not ok and bool(TRANSIENT.search(why))

def probe_clear():
    """Forget the day's cached probe results so the next pick asks again."""
    PROBE_CACHE.unlink(missing_ok=True)
    _PROBED.clear()

def cmd_models(a):
    """`models --probe`: clear the cached probe results and re-probe every model the crew chains name."""
    if not a.probe:
        sys.exit("models --probe clears the day's cached model probes and probes the crew models again")
    probe_clear()
    for model in dict.fromkeys(m for chain in [[(m, None)] for m in CREW_MODELS.values()] + list(CREW_FALLBACK.values()) for m, _ in chain):
        if is_claude(model) or str(model).startswith("pi:"):
            ok, why = model_available(model)
            print(f"{model}: {'ok' if ok else 'unavailable'} ({why})")

def crew_pick(role, explicit=None):
    return crew_pick_full(role, explicit)[:3]

def crew_pick_full(role, explicit=None):
    """(model, effort, note, skipped) where skipped lists why each earlier choice was passed over. (model, effort, note) for a teammate session. `--model` (a `claude:<id>` or `pi:<provider/model>`, or a name under
    models.crew such as `small`) wins, then models.crew[<role>], then `planner` for the planning role (the wayfinder
    teammate; never the team lead, which delegates), then `default`, then bare `claude`. An entry with a `fallback` (one entry or an ordered list)
    probes its model first and then each fallback in order, taking the first one its harness can run; when none can, it
    exits naming each model and the error its probe got, rather than starting a session that never comes up. Teammate sessions run in pi or Claude Code."""
    if explicit and explicit not in CREW_MODELS:
        key, chain = "--model", [(explicit, None)]
    else:
        first = role.split("-", 1)[0]
        key = explicit or (role if role in CREW_MODELS else
                           first if first != role and first in CREW_MODELS else
                           role if role in CREW_DEFAULTS else
                           "planner" if role in PLANNING_ROLES and "planner" in CREW_MODELS else
                           "default" if "default" in CREW_MODELS else None)
        if key is None:
            return "claude", None, "", []
        chain = [(CREW_MODELS[key], CREW_EFFORT.get(key)), *CREW_FALLBACK.get(key, [])] \
            if key in CREW_MODELS else [CREW_DEFAULTS[key]]
    label = "--model" if key == "--model" else f"models.crew.{key}" + (" default" if key == role and role in CREW_DEFAULTS and key not in CREW_MODELS else "")
    for m, _ in chain:
        if not (is_claude(m) or str(m).startswith("pi:")):
            where = "" if key == "--model" else f" in {CONFIG_PATH}"
            sys.exit(f"{label} is {m!r}, but teammate sessions run in Claude Code or pi: use claude:<model-id> (e.g. claude:claude-sonnet-5-5) "
                     f"or pi:<provider/model> (e.g. pi:openai/gpt-6-astra){where}; OpenCode ids are for implementers only")
    skipped = []
    if key != "--model" and role.split("-", 1)[0] in LINEAR_ROLES:
        skipped = [f"{m} skipped (a pi session has no Linear tools)" for m, _ in chain if not is_claude(m)]
        chain = [c for c in chain if is_claude(c[0])] or [("claude", None)]
    for model, effort in chain:
        if (ok := model_available(model))[0]:
            break
        skipped.append(f"{model} unavailable ({ok[1]})")
    else:
        sys.exit(f"{label}: no model in its chain can run: {', '.join(skipped)}. Fix the entry in {CONFIG_PATH} or pass --model; "
                 f"`fast-coding models --probe` re-asks after a transient failure")
    return model, effort, label + (": " + ", ".join(skipped) + ", using its fallback" if skipped else ""), skipped

def crew_fallback(proj, name, role, skipped, used):
    """A role that did not get its first-choice model: say so on screen and as a report `watch` wakes on, so the product owner hears of it."""
    msg = f"{role} wanted its first-choice model but {skipped[0]}; using {used}"
    print(f"WARNING: {msg}")
    write_report(proj, name, "fallback", msg)

def crew_model(role, explicit=None):
    return crew_pick(role, explicit)[0]

def crew_effort(role, explicit=None):
    """The Claude Code effort for the entry crew_pick chose, or None to keep Claude Code's default."""
    return crew_pick(role, explicit)[1]

def claude_trusted(path):
    """Whether Claude Code has accepted its folder-trust dialog for `path` or a parent (None when it cannot tell).
    An untrusted folder parks a new session at the trust prompt, so `crew start` says so instead of starting one."""
    try:
        projects = json.loads((Path.home() / ".claude.json").read_text()).get("projects") or {}
    except (OSError, json.JSONDecodeError):
        return None
    return any((projects.get(str(p)) or {}).get("hasTrustDialogAccepted") for p in (path, *path.parents))

def untrusted(path):
    return (f"Claude Code has never trusted {path}, so a session there would wait at its trust prompt. Run `claude` in "
            f"{path} once and accept the prompt (the product owner decides that), then start this teammate again.")

def crew_workdir(cwd, wt, name, role=None):
    """(directory, branch) a teammate session works in. A toolsmith's --cwd in a git repo, the project's own repo included, gets
    its own worktree on a new branch under that repo's .claude/worktrees, so no existing checkout (the repo's, a project
    worktree) ever switches branches. Any other teammate runs where it was pointed in its own repo (default: the project worktree)."""
    if not cwd:
        return wt, None
    cwd = Path(cwd)
    common = lambda d: sh(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], d, check=False).stdout.strip()
    theirs = common(cwd) if cwd.is_dir() else ""
    if not theirs or (theirs == common(wt) and role != "toolsmith"):
        return cwd, None
    top = Path(sh(["git", "rev-parse", "--show-toplevel"], cwd).stdout.strip())
    if claude_trusted(top) is False:
        sys.exit(untrusted(top))
    exclude = Path(theirs) / "info" / "exclude"
    if "/.claude/worktrees/" not in (exclude.read_text() if exclude.exists() else ""):
        exclude.parent.mkdir(parents=True, exist_ok=True)
        with exclude.open("a") as f:
            f.write("/.claude/worktrees/\n")
    branch = f"{name}-{time.strftime('%Y%m%d-%H%M%S')}"
    if use_treehouse():
        sh(["git", "branch", branch, "HEAD"], top)
        return slot_on(top, branch, f"fast-coding:{name}"), branch
    path = top / ".claude" / "worktrees" / branch
    sh(["git", "worktree", "add", "-q", "-b", branch, str(path), "HEAD"], top)
    return path, branch

TRIAGE_BAR = ("Flag the layer only for: a change outside its listed files; hardening, flags, helpers, or abstractions the brief "
              "does not ask for; code far more complex than the brief needs; a UI state not placed or styled the way the brief says; "
              "anything aimed at the test rather than the user. Everything else is clean; style nits are clean.")

def triage(repo, proj, ids):
    """One fast-model look per passed task, all at once: `clean`, or `flag: <reason quoting the code>`. It only points the
    team lead at layers to read in full; it never rejects. Stored as `triage` in the task's result file."""
    env = fast_env()
    if not env.get("TEXT_MODEL_API_KEY"):
        return {}
    metas = {m["id"]: m for m in load_tasks(proj)}
    trunk = current_branch(repo)
    def one(tid):
        m, branch = metas.get(tid) or {}, f"fast/{proj.name}/{tid}"
        try:
            base = sh(["git", "merge-base", trunk, branch], repo).stdout.strip()
            diff = sh(["git", "diff", base, branch, "--", *(m.get("files") or [])], repo, check=False).stdout
            v = fast_json(env, "You triage one finished coding task for a senior reviewer. " + TRIAGE_BAR +
                          ' Return JSON {"verdict": "clean" | "flag", "reason": str}; a flag reason is one line quoting the code.',
                          f"TASK BRIEF:\n{(m.get('body') or '')[:6000]}\n\nFILES IT MAY CHANGE: {', '.join(m.get('files') or [])}\n\n"
                          f"DIFF:\n{diff[:40000]}", max_tokens=300, timeout=30)
            verdict, reason = ("flag" if v.get("verdict") == "flag" else "clean"), str(v.get("reason") or "").strip()[:300]
        except Exception as e:  # noqa: BLE001 - triage is advisory
            verdict, reason = "unknown", f"triage failed: {str(e)[:150]}"
        f = proj / "results" / f"{tid}.json"
        if f.exists():
            r = json.loads(f.read_text()); r["triage"] = {"verdict": verdict, "reason": reason}
            atomic_write(f, json.dumps(r, indent=2))
        return tid, verdict, reason
    with ThreadPoolExecutor(max_workers=8) as ex:
        out = list(ex.map(one, ids))
    for tid, verdict, reason in out:
        say(f"{tid} triage  {verdict}" + (f": {reason}" if verdict != "clean" and reason else ""))
    return {tid: (v, r) for tid, v, r in out}

def cmd_triage(a):
    proj = project_dir(a); repo = Path(a.repo).resolve()
    ids = [x.strip() for x in a.only.split(",")] if a.only else sorted(
        f.stem for f in (proj / "results").glob("[0-9]*.json") if json.loads(f.read_text()).get("status") == "passed")
    if not triage(repo, proj, ids):
        sys.exit("no fast-model key (TEXT_MODEL_API_KEY) or no passed tasks: nothing triaged")

# ---------- groundwork: the boilerplate brief, then one test-writing teammate per task on a shared contract ----------

def detect_stacks(wt):
    """One line per toolchain the probe must cover, from the manifests at the root and one level down."""
    found = []
    for d in [wt] + sorted(c for c in wt.iterdir() if c.is_dir() and not c.name.startswith(".") and c.name != "node_modules"):
        rel = "." if d == wt else d.name
        if (d / "go.mod").exists():
            found.append(f"- Go module in {rel}: go mod download, go build ./..., go vet ./..., go test ./..., gofmt -l, and any codegen it uses")
        if (d / "package.json").exists():
            pm = ("pnpm" if (d / "pnpm-lock.yaml").exists() else "yarn (npx yarn@1 when yarn is not on PATH)" if (d / "yarn.lock").exists()
                  else "npm ci" if (d / "package-lock.json").exists() else "the package manager its README names")
            found.append(f"- Node package in {rel} with {pm}: install from the lockfile, its test, build, and start scripts")
        if (d / "pyproject.toml").exists() or (d / "requirements.txt").exists():
            found.append(f"- Python in {rel}: a venv, install, the test command, and how it starts")
        if (d / "Cargo.toml").exists():
            found.append(f"- Rust crate in {rel}: cargo build, cargo test")
    return "\n".join(found) or "- no manifest found: read the README for how it builds and starts"

GROUNDWORK_BRIEF = """You are the groundwork teammate for project {slug}. Worktree: {wt}, branch {trunk}. The task briefs are the contract:
read them first with `fast-coding tasks --repo {wt} --project {slug}`. Use `graft ask "<question>" --source` for code context.
Commit on {trunk} in small commits with plain messages. Nothing is pushed.

Phase A, toolchain (probe and report; you never change dependencies):
{stacks}
1. Install from the lockfiles, then build, test, and start every part the way a user would (start the server and probe one URL; start the client with BROWSER=none and probe it). Unit tests passing is not proof the app runs.
2. For each breakage find the smallest fix that works (a documented setting, or an upgrade); try it on a scratch copy if needed, and leave the worktree's dependencies and lockfiles as they are.
3. Report `working "toolchain: <what breaks>; recommend <fix>, alternative <alt>"` and wait for the team lead's go in this pane.

Phase B, after the go (the settled choices reach the planner as tasks):
1. Dependency, lockfile, and toolchain changes are implementer tasks, never yours: the planner splits them like any other work, and a choice the probe found is a wayfinder card the product owner settles first. Change no dependency.
2. Write the schema, codegen, wiring, and stubs the task briefs need, with the exact signatures the briefs give: stubs compile and return "not implemented" errors, zero values, or null. No feature logic.
3. verify.json ({verify}, keep existing keys): `checks` = every smoke command that passed (build, vet, unit tests, formatter check, client build). For anything with a UI or server: `e2e_setup` starting the server on $E2E_PORT and the client on $E2E_CLIENT_PORT (the CLI hands out free ports and stops what the setup starts; never hardcode a port the app does not pin, never free ports with lsof or kill), `e2e_setup_wait`, and one `e2e` case per user flow with a goal and an `assert` script that checks the real log or DOM. Driver and assert scripts go in {e2e_dir}, never in ~/.fast-coding or /tmp.
4. Commit.

Phase C, the contract (you write no tests: one teammate per task writes them in parallel from your contract):
Write {contract} (outside the repo; never commit it) with exactly what a test writer needs and must not guess:
- every type, struct, and generated model a test touches, with its package and whether it is a value or a pointer
- every stub's exact signature, and which task implements it
- the test helpers and fixtures to use (an in-memory DB, how to fake the client or network, a provider wrapper), with a short example
- per task: the test file path (its `protected:`), the test function or describe names its `test:` command selects, and that command
Report `working "stubs ready: <commit>; contract at {contract}"`. Report `done` only when the team lead says so.
"""

def cmd_groundwork(a):
    """Print the groundwork brief for this project, plus the team lead's project notes from --extra (or stdin with `-`)."""
    proj = project_dir(a); wt = project_worktree(proj)
    extra = sys.stdin.read() if a.extra == "-" else (a.extra or "")
    print(GROUNDWORK_BRIEF.format(slug=proj.name, wt=wt, trunk=current_branch(wt), stacks=detect_stacks(wt),
                                  verify=proj / "verify.json", contract=proj / "results" / "contract.md", e2e_dir=proj / "e2e")
          + (f"\nProject notes from the team lead:\n{extra.strip()}\n" if extra.strip() else ""))

WAYFINDER_BRIEF = """You are the wayfinder teammate for project {slug}. Worktree: {wt}. The map is the feature issue {feature} on Linear:
its description holds Destination, Notes, Decisions so far, Not yet specified, Out of scope. It is the one decision record.
1. Read the map, the spec or README named below, and the repo (`graft ask "<question>" --source`). Before asking anything, look
   for the answer in Linear: the map's Decisions so far and Notes, the feature's and its epic's comments, and a `list_issues`
   search in the project for the question's key terms. A decision found there is settled: do not ask it again.
2. Chart the map body on the feature issue (`save_issue`), then write every open question as a card: the question, why it
   matters, the options with one line each, and your recommended option marked. Never choose for the product owner: every card
   carries a recommendation, the product owner answers. Decide the channel per card with one test: would the product owner
   understand it better by seeing it than reading it? Text (the default) for requirements, conceptual choices, tradeoffs, scope,
   and toolchain; a UI topic alone is not visual. Lavish only for a card whose content IS visual: a Frame0 wireframe, a layout or
   flow comparison, a diagram, side-by-side designs. Visual cards go on one page, text cards never: {page}
   For that page read `npx -y lavish-axi playbook input` and `npx -y lavish-axi design` first (the project's own design system if
   it has one, else the Lavish-recommended Tailwind and DaisyUI CDN). Set data-lavish-annotate="off" on <html>. Each card is a
   form with data-lavish-question, the recommended option preselected, a free-text box, and one answer button; the top of the page
   has one "accept every recommendation" button. Each sends exactly one window.lavish.queuePrompt with text "<question>: <answer>"
   and data {{question, answer}}; accept-all sends data {{question: "accept-all", answer: [{{question, answer}}, ...]}} with every
   card's recommendation.
3. Ask once. Open the page if there is one (`npx -y lavish-axi {page}`), then report, before any poll and whatever the CLI's
   next_step text says: `fast-coding report --project {slug} --as {name} needs-user "<the text cards in full: question, why,
   options, recommendation; 'accept every recommendation' is a one-word answer; plus 'visual cards open in Lavish: {page}' when
   the page is open>"`. The team lead relays it to the engineering manager, which asks the product owner every open card at once.
4. Wait. Text answers come back as a prompt in this pane: the team lead forwards them with `herdr agent prompt {name} "<answers>"`.
   A visual page: `npx -y lavish-axi poll {page}` in the foreground of this pane. Never background or kill it, never reopen a
   session the product owner ended. Answers arrive in the poll's `text` column (and as JSON after "Context data:" inside
   `prompt`), not as a data field. If the poll is interrupted, or your Bash call ends first (Claude stops a call at 10 minutes),
   run it again at once, as often as it takes: queued answers wait for you.
5. Record each answer in the map's Decisions so far as it arrives: one line each, a `save_issue` patch append, never a
   whole-description write.
6. New questions the answers open, and the groundwork teammate's toolchain findings when the team lead forwards them (which version, which option),
   are asked the same way, and the planner cuts what the product owner settles into implementer tasks: text cards in a new needs-user; visual cards added to the same page, then
   `npx -y lavish-axi poll {page} --agent-reply "<what changed>"` and wait again.
7. When every card is answered and Not yet specified is empty: `npx -y lavish-axi end {page}` if the page was opened, then report
   `done` with the decisions in one line each.
"""

PLANNER_BRIEF = """You are the planner teammate for project {slug}. Worktree: {wt}. Your ticket is {issue} on Linear; you are {name}.
You continue specing from where it stopped: the plan, the task issues, or a re-cut. You write Linear and the CLI's JSON only, never
code. You never run `fast-coding run`: you never dispatch. You cut only for this ticket's feature, never for the whole project.
Every teammate you start runs in its own pane (`fast-coding crew start`); never do its job inline.

1. Your level sets the job (read it from the ticket's label, else its parent chain):
   - Project link: list its epics and features with their story and task counts, and ask which one to continue (needs-user).
   - Epic: one planner per feature, in parallel. Fog (its features cannot be named yet) is wayfinder's: hand it to 0b and stop.
   - Feature: check the map is settled (Not yet specified empty), the `### Codebase brief` is in its Notes, and it has a `## Plan`.
     No plan: write `## Plan` in the feature description (`save_issue`, never a file): numbered steps, each with the files it
     touches, the test that proves it, and its dependencies; decisions already made are not reopened. Stories missing: propose
     them as one needs-user list (one per user-visible slice, acceptance criteria in each, in ship order) and create them in
     Linear only on the product owner's go. Then check and cut each story.
   - Story: check and cut this story only; other stories' tasks are not touched.
   - Task: lint it against the format and the cutting rules below; re-split it if it fails.
   - A loose idea is not the planner's: say so and point at the fast-coding skill's step 0.

2. The spec check, per story, in the order the gaps are cheapest to close:
   1. A Feature parent with a settled map: Destination, Decisions so far, Not yet specified empty, no open questions left.
   2. `### Codebase brief` in the feature's Notes; without it no file may be named.
   3. Acceptance criteria present, each a behavior a test can check, each traceable to a decision line or the spec's words.
   4. Every criterion maps to a file or symbol via `graft ask` or `graft callers` in the worktree; new files are listed as new.
   5. The test command is known (verify.json `checks`, else the codebase brief's test setup), and a test path per task for `protected:`.
   6. No open how: every "how" is stated or obvious from the named files; events are named; rules link to their decision.
   7. The groundwork contract (contract.md) is not needed to cut: it is for the test writers. Name the test paths and say in
      the brief that signatures come from the contract.
   Checks 1, 3, 6 are decision gaps: each is a text card (the question, why it matters, the options, your recommendation), all
   of them in one `fast-coding report --project {slug} --as {name} needs-user "<the cards in full>"`. You never answer a card.
   Lavish only when a card is visual (a wireframe, layout comparison, or diagram): the wayfinder teammate draws it;
   start it as below with `wayfinder` in place of `explore`.
   Checks 2, 4, 5 are fact gaps: start an explore or groundwork teammate, never ask the product owner:
   `fast-coding explore --project {slug} --extra - | fast-coding crew start --role explore --project {slug} --brief -`
   (or `groundwork` in both places).
   A story that fails: report `blocked "<story>: not specced: <gap list>"`, naming the cards. The gap list is one comment on
   the story.

3. Cut each checked story into task issues. A task is right-sized when all of these hold:
   - one or two files in `files:`, one test command, at most five acceptance criteria
   - its brief (the issue description) is under 2500 characters
   - its branch stays within the CLI's 350-line limit (added plus deleted)
   - no documents: no .md, .txt, .rst, or docs/ files
   - `files:` names every file it may touch, new files too
   - no file shared by two tasks: a shared file means one task, or one is `after:` the other
   - `after:` only for code a task needs (it calls, imports, or edits what the other creates), set as the issue's blocked-by links
   - ids numbered in review order
   A story-sized criterion (one that spans several behaviors) is split, not copied.
   A story is never done by groundwork alone: every code, dependency, lockfile, and toolchain change is a task. Name the lockfile in
   `files:` (lockfiles do not count toward the 350 lines). A choice it needs (which version, which option) is a decision card
   (checks 1, 3, 6), settled before the task is cut. Only work that is not code (a manual browser run that needs the product
   owner's sign-in) stays teammate work, and it never exempts the story from tasks for its code.

4. The task issue: a sub-issue of its story, label Task, state Todo, its title the task's title. Its description, in this order:
   ## Goal
   One paragraph: what to build, where, exact export names.
   ## Acceptance criteria
   One bullet per behavior, each checked by the test.
   ## Test plan
   How to run (the `test:` command), what is covered in words, and that the test has holdout cases not listed.
   ## Constraints
   No new dependencies beyond what the goal names. Do not edit protected files.
   and last, the block the CLI reads:
   ```fast-coding
   id: 001
   files: <the one or two paths>
   protected: <the test path>
   test: <the test command>
   ```
   Its keys are id, files, protected, test; `model:` is optional, leave it unset. `after` and `title` are not block keys:
   `after` is the blocked-by links, `title` is the issue's own title.

5. After cutting: `fast-coding sync` (the feature and every issue under it, read from Linear and piped in as step 2 of the
   fast-coding skill says), then `fast-coding spec-check --project {slug}`, then `fast-coding tasks`; fix every FAIL and WARNING.
   A first cut and a re-cut are one diff: read the story's live task issues, compare them to the story and the map, then
   cancel, edit, add; ids stay monotonic, and a canceled task loses its `fast-coding` block.
   Once a task of the feature was dispatched, the edits go inside `fast-coding change start --why "<one line>"` (sync first)
   and `fast-coding change done` (sync first). Before the first dispatch, no change.

6. Design stories (label Design) go to the designer role, not cut by you: report the hand-off in one line. Code stories do not
   wait: cut them now, and note on the feature the design stories still open.

7. Report the cut with each story's task issue ids.
"""

